// Firestore security rules: who can read and write which data.
// Paste these into Firebase console → Firestore Database → Rules, then Publish.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Private profile (surname, email). Only the member and the owner can
    // read it, and members can never make themselves an admin.
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid) && request.resource.data.role == "member";
      allow update: if isAdmin() || (isSelf(uid) && request.resource.data.role == resource.data.role);

      match /checkins/{date} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if isSelf(uid);
      }
      match /practice/{date} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if isSelf(uid);
      }
      // Morning intentions, evening reviews and craving notes: the member's own words.
      // The owner can read them only if the member agreed (reflectionConsent on their profile).
      match /reflections/{id} {
        allow read: if isSelf(uid)
          || (isAdmin() && get(/databases/$(database)/documents/users/$(uid)).data.reflectionConsent == true);
        allow write: if isSelf(uid);
      }
      // Counts only (no words), so the owner can always see activity.
      match /activity/{date} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if isSelf(uid);
      }
      match /practiceChecks/{id} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isSelf(uid);
      }
      // Cohort memberships. Members can join free cohorts themselves; paid
      // ones are added by the server after Stripe payment. Members may only
      // change their own restart date, and mark that they joined the WhatsApp group.
      match /memberships/{cohortId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isAdmin()
          || (isSelf(uid) && get(/databases/$(database)/documents/cohorts/$(cohortId)).data.price == 0);
        allow update: if isAdmin()
          || (isSelf(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["personalStartDate", "whatsappJoined"]));
        allow delete: if isAdmin();
      }
    }

    // Public profile: first name, avatar, streak and badges. Other members
    // can only see it if the member has opted in.
    match /publicProfiles/{uid} {
      allow read: if isSelf(uid) || isAdmin() || (signedIn() && resource.data.leaderboardOptIn == true);
      allow write: if isSelf(uid);
    }

    // Access and payments: written only by the server (after Stripe confirms a payment),
    // never from the app. Members can read their own access; the owner can read everything.
    match /members/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if false;
    }
    match /cohortEntitlements/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }
    match /payments/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Study Group subscriptions: written only by the Stripe webhook. Members can read their own.
    match /studyGroupSubscriptions/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }
    // What each member agreed to before paying for the Study Group (terms version, time,
    // immediate access). Written only by the server.
    match /studyGroupConsents/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }
    // Each member's Stripe customer (for the Customer Portal). Server only.
    match /stripeCustomers/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if false;
    }
    // Stripe events already handled (so a repeated webhook does nothing twice). Server only.
    match /stripeEvents/{id} {
      allow read, write: if false;
    }

    // The public copy of each cohort (name, habit, dates, price): anyone can read it, so the
    // home page can list cohorts before signing in. Only the owner writes it.
    match /publicCohorts/{cohortId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Cohorts: everyone logged in can see them; only the owner edits them.
    // A member may add only themselves to a free cohort's member list.
    match /cohorts/{cohortId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
            && resource.data.price == 0
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberIds"])
            && request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()) == [request.auth.uid].toSet());
    }

    // Messages from the owner (Admin → Messages).
    match /notices/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Zoom link, session date, weekly media links.
    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Lets the owner list everyone's check-ins and memberships at once.
    match /{path=**}/checkins/{date} { allow read: if isAdmin(); }
    match /{path=**}/memberships/{cohortId} { allow read: if isAdmin(); }
    match /{path=**}/activity/{date} { allow read: if isAdmin(); }
  }
}
