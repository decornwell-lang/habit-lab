// Firestore security rules: who can read and write which data.
// Paste these into Firebase console → Firestore Database → Rules, then Publish.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Private profile (surname, email). Only the member and the owner can
    // read it, and members can never make themselves an admin.
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid) && request.resource.data.role == "member";
      allow update: if isAdmin() || (isSelf(uid) && request.resource.data.role == resource.data.role);

      match /checkins/{date} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if isSelf(uid);
      }
      match /practice/{date} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if isSelf(uid);
      }
      match /practiceChecks/{id} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isSelf(uid);
      }
      // Cohort memberships. Members can join free cohorts themselves; paid
      // ones are added by the server after Stripe payment. Members may only
      // change their own restart date.
      match /memberships/{cohortId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isAdmin()
          || (isSelf(uid) && get(/databases/$(database)/documents/cohorts/$(cohortId)).data.price == 0);
        allow update: if isAdmin()
          || (isSelf(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["personalStartDate"]));
        allow delete: if isAdmin();
      }
    }

    // Public profile: first name, avatar, streak and badges. Other members
    // can only see it if the member has opted in.
    match /publicProfiles/{uid} {
      allow read: if isSelf(uid) || isAdmin() || (signedIn() && resource.data.leaderboardOptIn == true);
      allow write: if isSelf(uid);
    }

    // Cohorts: everyone logged in can see them; only the owner edits them.
    // A member may add only themselves to a free cohort's member list.
    match /cohorts/{cohortId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
            && resource.data.price == 0
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberIds"])
            && request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()) == [request.auth.uid].toSet());
    }

    // Pods. Cohort members can see which pods exist (to find one with space),
    // add only themselves to a pod with fewer than 4 members, or remove themselves.
    match /pods/{podId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid in get(/databases/$(database)/documents/cohorts/$(resource.data.cohortId)).data.memberIds);
      allow create: if signedIn()
        && request.resource.data.memberIds == [request.auth.uid]
        && request.auth.uid in get(/databases/$(database)/documents/cohorts/$(request.resource.data.cohortId)).data.memberIds;
      allow update: if isAdmin() || (signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberIds"])
        && ((request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()) == [request.auth.uid].toSet()
             && resource.data.memberIds.size() < 4
             && request.auth.uid in get(/databases/$(database)/documents/cohorts/$(resource.data.cohortId)).data.memberIds)
          || (resource.data.memberIds.toSet().difference(request.resource.data.memberIds.toSet()) == [request.auth.uid].toSet()
             && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1)));
      // Any pod member can set or remove the pod's WhatsApp group invite link.
      allow update: if signedIn() && request.auth.uid in resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["whatsappGroupLink", "groupLinkSetBy"])
        && (request.resource.data.whatsappGroupLink == null
            || request.resource.data.whatsappGroupLink.matches("^https://chat[.]whatsapp[.]com/[A-Za-z0-9]+$"));
      allow delete: if isAdmin();

      // Member cards (first name, avatar, and phone only if they chose to share it).
      // Only people in this pod can read them.
      match /members/{uid} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid in get(/databases/$(database)/documents/pods/$(podId)).data.memberIds);
        allow create, update: if isAdmin()
          || (isSelf(uid) && request.auth.uid in getAfter(/databases/$(database)/documents/pods/$(podId)).data.memberIds);
        allow delete: if isSelf(uid) || isAdmin();
      }
    }

    // Requests to change pod. Members create their own; the owner reads and resolves them.
    match /podRequests/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.status == "open";
      allow update, delete: if isAdmin();
    }

    // Messages from the owner (Admin → Messages).
    match /notices/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Zoom link, session date, weekly media links.
    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Lets the owner list everyone's check-ins and memberships at once.
    match /{path=**}/checkins/{date} { allow read: if isAdmin(); }
    match /{path=**}/memberships/{cohortId} { allow read: if isAdmin(); }
  }
}
