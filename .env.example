# Copy this file to ".env.local" and fill in the real values.
# ".env.local" is never uploaded to GitHub. On Vercel, add the same
# names under Project → Settings → Environment Variables.

# Firebase (Firebase console → Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Push notifications: Firebase console → Project settings → Cloud Messaging
# → Web Push certificates → "Key pair" (the public key; safe in the browser)
VITE_FIREBASE_VAPID_KEY=

# Server only (never starts with VITE_): Firebase console → Project settings →
# Service accounts → Generate new private key. Paste the whole JSON on one line.
# Needed for payments and for sending push notifications.
FIREBASE_SERVICE_ACCOUNT=

# Stripe: use TEST keys until launch. The secret key is server-only.
# STRIPE_TAX=on once Stripe Tax is set up (works out the VAT inside each price).
STRIPE_SECRET_KEY=
STRIPE_TAX=

# Daily notifications (06:00, 08:00, 21:00): a long random password shared by Vercel and
# the GitHub Action (.github/workflows/daily-prompts.yml, secret CRON_SECRET).
CRON_SECRET=
